[Unit]
Description=Renew TypingDongnanya short-lived IP certificate
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/typing-dongnanya-api/certbot/bin/certbot renew --quiet
ExecStartPost=/usr/sbin/nginx -t
ExecStartPost=/usr/bin/systemctl reload nginx.service
