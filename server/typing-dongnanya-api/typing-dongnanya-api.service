[Unit]
Description=TypingDongnanya translation proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=typing-dongnanya-api
Group=typing-dongnanya-api
WorkingDirectory=/opt/typing-dongnanya-api/current
ExecStart=/opt/typing-dongnanya-api/current/typing-dongnanya-api
Restart=on-failure
RestartSec=3
EnvironmentFile=/etc/typing-dongnanya-api/typing-dongnanya-api.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/typing-dongnanya-api

[Install]
WantedBy=multi-user.target
